{
  "name": "@resolvehub/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "dotenv -e ../../.env -v NODE_ENV=production -- node ../../scripts/start-web.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@resolvehub/contracts": "workspace:*",
    "@resolvehub/generated": "workspace:*",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.548.0",
    "zod": "^4.1.12",
    "@resolvehub/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "tailwindcss": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv-cli": "^10.0.0"
  }
}
