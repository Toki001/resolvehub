{
  "name": "resolvehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.22.3 <23",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "start": "turbo run start --env-mode=loose",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @resolvehub/generated generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "pnpm exec tsx scripts/test-integration.ts",
    "test:e2e": "dotenv -e .env -- playwright test",
    "smoke": "dotenv -e .env -- tsx scripts/smoke.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:check": "docker compose config --quiet",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm test",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "contracts:drift": "pnpm generate && node scripts/check-generated.mjs",
    "db:migrate": "turbo run build --filter=@resolvehub/db && dotenv -e .env -- tsx scripts/migrate.ts",
    "env:setup": "node scripts/setup-env.mjs",
    "auth:bootstrap": "turbo run build --filter=@resolvehub/db && dotenv -e .env -- tsx scripts/bootstrap-auth.ts",
    "db:seed": "turbo run build --filter=@resolvehub/db && dotenv -e .env -- tsx scripts/seed.ts",
    "db:bootstrap": "turbo run build --filter=@resolvehub/db && dotenv -e .env -- tsx scripts/bootstrap-database.ts",
    "test:unit": "pnpm test",
    "test:coverage": "pnpm exec tsx scripts/test-integration.ts --coverage",
    "test:all": "pnpm test:coverage"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "9.9.0",
    "@jest/globals": "30.5.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@playwright/test": "^1.56.1",
    "@resolvehub/ai": "workspace:*",
    "@resolvehub/contracts": "workspace:*",
    "@resolvehub/db": "workspace:*",
    "@resolvehub/generated": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.61.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "graphql": "^16.11.0",
    "ioredis": "^5.11.1",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "turbo": "2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  }
}
