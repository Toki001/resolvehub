# Development values only. Copy to .env; never commit .env.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
PORT=3000
API_HOST=127.0.0.1
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Run pnpm env:setup to generate this secret in the ignored .env.
# Used with separate derived keys for encrypted cursors and webhook secrets.
API_SECRET_KEY=GENERATE_WITH_PNPM_ENV_SETUP
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
WORKER_URL=http://127.0.0.1:3002
DATABASE_URL=postgresql://resolvehub:resolvehub_local_only@127.0.0.1:5432/resolvehub
POSTGRES_USER=resolvehub
POSTGRES_PASSWORD=resolvehub_local_only
POSTGRES_DB=resolvehub
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=resolvehub_local
MINIO_ROOT_PASSWORD=resolvehub_local_secret
S3_BUCKET=resolvehub
WORKER_CONCURRENCY=2
# Deterministic mock AI only; no external calls.
AI_PROVIDER=mock

# Explicit synthetic embedding model, pinned by migration 0003 (not semantic AI).
# Changing model/dimensions requires a new migration and a complete reindex.
EMBEDDING_MODEL=resolvehub-synthetic-sha256-v1
EMBEDDING_DIMENSIONS=64

# Worker storage credentials: use a scoped S3 access key outside local Compose.
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY fall back to the supplied local MinIO credentials.
# WORKER_DATABASE_URL can override DATABASE_URL with the separate worker role.
INGESTION_QUEUE_PREFIX=resolvehub
INGESTION_ATTEMPT_TIMEOUT_MS=60000
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_REQUESTS_PER_SECOND=10
