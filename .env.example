# Development values only. Copy to .env; never commit .env.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
API_URL=http://127.0.0.1:3001
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
WORKER_URL=http://127.0.0.1:3002
DATABASE_URL=postgresql://resolvehub:resolvehub_local_only@127.0.0.1:5432/resolvehub
POSTGRES_USER=resolvehub
POSTGRES_PASSWORD=resolvehub_local_only
POSTGRES_DB=resolvehub
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=resolvehub_local
MINIO_ROOT_PASSWORD=resolvehub_local_secret
S3_BUCKET=resolvehub
WORKER_CONCURRENCY=2
# Only deterministic mock AI is available in milestone 01; no external calls.
AI_PROVIDER=mock
