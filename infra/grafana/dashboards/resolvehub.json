{
  "uid": "resolvehub-operations",
  "title": "ResolveHub operations",
  "tags": ["resolvehub"],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(resolvehub_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resolvehub_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(resolvehub_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Draft completion latency (queue included)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(resolvehub_draft_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resolvehub_draft_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(resolvehub_draft_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Queue wait after ready-at",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(resolvehub_queue_wait_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resolvehub_queue_wait_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(resolvehub_queue_wait_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "RAG retrieval latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(resolvehub_rag_retrieval_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(resolvehub_rag_retrieval_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(resolvehub_rag_retrieval_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Request throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(resolvehub_http_requests_total[$__rate_interval]))",
          "legendFormat": "HTTP"
        },
        {
          "refId": "B",
          "expr": "sum(rate(resolvehub_graphql_requests_total[$__rate_interval]))",
          "legendFormat": "GraphQL"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Failure rates",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(resolvehub_http_requests_total{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(resolvehub_http_requests_total[$__rate_interval])),0.001)",
          "legendFormat": "HTTP 5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(resolvehub_graphql_requests_total{outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(resolvehub_graphql_requests_total[$__rate_interval])),0.001)",
          "legendFormat": "GraphQL"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Durable pending and active jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job_kind) (resolvehub_queue_pending)",
          "legendFormat": "pending {{job_kind}}"
        },
        {
          "refId": "B",
          "expr": "max by (job_kind) (resolvehub_queue_active)",
          "legendFormat": "active {{job_kind}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Oldest pending age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job_kind) (resolvehub_queue_oldest_age_seconds)",
          "legendFormat": "{{job_kind}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Retry events and authoritative retry count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job_kind) (increase(resolvehub_queue_retries_total[$__rate_interval]))",
          "legendFormat": "events {{job_kind}}"
        },
        {
          "refId": "B",
          "expr": "max by (job_kind) (resolvehub_queue_retries_durable)",
          "legendFormat": "durable {{job_kind}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Durable unreplayed dead letters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job_kind) (resolvehub_queue_dead_letters)",
          "legendFormat": "{{job_kind}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Successful ingestion throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(resolvehub_ingestion_completed_total{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "documents/sec"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Model token throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,model,token_type) (rate(resolvehub_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{provider}} {{model}} {{token_type}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Cost per completed draft",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(resolvehub_draft_cost_usd_sum[$__rate_interval])) / clamp_min(sum(rate(resolvehub_draft_cost_usd_count[$__rate_interval])),0.001)",
          "legendFormat": "mean"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(resolvehub_draft_cost_usd_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "Generation latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(resolvehub_generation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "Operation failure throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(resolvehub_operation_failures_total[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Collector availability and observation freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "resolvehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"otel-collector\"}",
          "legendFormat": "collector up"
        },
        {
          "refId": "B",
          "expr": "max(resolvehub_queue_observation_age_seconds)",
          "legendFormat": "queue observation age seconds"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Trace search \u2014 redacted operations",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "resolvehub-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"resolvehub-.*\" }",
          "limit": 20
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}
